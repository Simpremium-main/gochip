# Mesmo projeto Supabase do Pedido Central.
NEXT_PUBLIC_SUPABASE_URL=
# Chave service role: usada SOMENTE no servidor (rotas /api). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Mercado Livre: o GoChip usa a conta que o Pedido Central conectou (system_settings).
# Só são lidos daqui se o App ID / Client Secret não estiverem cadastrados na tela do Pedido Central.
ML_APP_ID=
ML_CLIENT_SECRET=
# WhatsApp do suporte (DDI + DDD + número, só dígitos). Vazio = 551149495008 (padrão no código).
WHATSAPP_SUPORTE=
